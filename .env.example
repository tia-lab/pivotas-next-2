# Project identity - rewritten by `bun env:create` from the folder name by default.
# Override with `bun env:create --project-name=my-project` when needed.
PROJECT_NAME=ubiq-next-cyon

# Local development only. Next and DDEV revalidation use the same port.
DEV_PORT=3000

# Next runtime -> Craft
# Configure the Craft values in Vercel for Preview and Production.
CRAFT_GRAPHQL_ENDPOINT=
CRAFT_PRIMARY_URL=
CRAFT_GRAPHQL_TOKEN=
# Optional canonical URL override. Vercel deployments use their system URL.
NEXT_PUBLIC_SITE_URL=

# Craft -> Next
# Configure REVALIDATE_SECRET and CRAFT_PREVIEW_SECRET in both Vercel and Craft/Cyon.
# Generated by `bun env:create`; configure the same value in Vercel.
REVALIDATE_SECRET=
# Set to the stable Next production domain followed by /api/revalidate.
# Local DDEV derives its callback from DEV_PORT instead of this hosted value.
CRAFT_REVALIDATE_URL=

# Live Preview
# Generated by `bun env:create`; configure the same value in Vercel and Craft/Cyon.
CRAFT_PREVIEW_SECRET=

# Hosted Craft / Cyon
CRAFT_SECURITY_KEY=
CRAFT_LICENSE_KEY=''
PRIMARY_SITE_URL=
CRAFT_DISALLOW_ROBOTS=true

# Hosted Craft database
CRAFT_DB_SERVER=
CRAFT_DB_DATABASE=
CRAFT_DB_USER=
CRAFT_DB_PASSWORD=

# Manual Craft hosting over SSH
# Keep all private runtime and SSH values in the single ignored root .env.
# REMOTE_PROJECT_PATH is the Craft app root; the domain document root must point
# to its web/ directory.
REMOTE_HOST=
REMOTE_USER=
REMOTE_SSH_KEY=
REMOTE_PROJECT_PATH=
